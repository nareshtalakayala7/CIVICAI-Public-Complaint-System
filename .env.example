# Generate distinct random values before any non-demo deployment.
SECRET_KEY=replace-with-a-random-session-secret
JWT_SECRET_KEY=replace-with-a-different-random-jwt-secret

# SQLite is used automatically if DATABASE_URL is omitted.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://civicai:civicai@localhost:5432/civicai

# Demo seed data is inserted when the database is first created.
CIVICAI_SEED_DEMO=1
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
PORT=5000

# Optional SMTP email. In-app notifications always work without SMTP.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.org
